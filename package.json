{
  "name": "placement-prediction-dbms",
  "version": "1.0.0",
  "private": true,
  "description": "AI-based placement prediction and job recommendation system (DBMS project)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "db:start": "node scripts/start-mysql.js",
    "db:stop": "node scripts/stop-mysql.js",
    "db:setup": "npm --workspace backend run db:setup",
    "seed": "npm --workspace backend run seed",
    "train": "npm --workspace backend run train",
    "setup": "node setup.js",
    "backend": "npm --workspace backend start",
    "frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "vercel-build": "npm run build",
    "start": "npm --workspace backend start"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.19"
  }
}
