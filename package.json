{
  "name": "placement-prediction-dbms",
  "version": "1.0.0",
  "private": true,
  "description": "AI-based placement prediction and job recommendation system (DBMS project)",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "db:start": "node scripts/start-mysql.js",
    "db:stop": "node scripts/stop-mysql.js",
    "db:setup": "npm --prefix backend run db:setup",
    "seed": "npm --prefix backend run seed",
    "train": "npm --prefix backend run train",
    "setup": "node setup.js",
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  }
}
