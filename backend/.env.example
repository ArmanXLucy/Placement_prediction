# --- Local development ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=placement_db

# Set DB_SSL=true when your hosted MySQL provider requires TLS
# (Aiven, TiDB Cloud, Railway, PlanetScale, ...).
DB_SSL=false

# Maximum pool size. Keep it small in serverless environments (default 3 on Vercel).
DB_POOL_SIZE=

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
PORT=5000

# Demo mode: in-memory data, no MySQL required.
# Leave unset on Vercel (auto-enabled). Set false to use the database above.
DEMO_MODE=false
